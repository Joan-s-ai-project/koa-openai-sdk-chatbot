OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.ppinfra.com/v3/openai
DEFAULT_MODEL=zai-org/glm-5
DEFAULT_TEMPERATURE=0.7
SYSTEM_PROMPT=你是一个友好、专业的 AI 助手，用中文回答问题。
DATA_DIR=data/
PORT=3000
TAVILY_API_KEY=your_tavily_api_key

# ── MiMo Provider ──────────────────────────────────────────────────────
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── OpenMem (MemOS) 记忆服务 ───────────────────────────────────────────
# 从 https://memos-dashboard.openmem.net/apikeys/ 获取
MEMOS_API_KEY=your-memos-api-key
# 稳定的用户标识符，建议用 SHA-256(lowercase(email))，不要用随机值或 session ID
MEMOS_USER_ID=your-stable-user-id
# 可选，默认 https://memos.memtensor.cn/api/openmem/v1
# MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
